<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime blocks Apple Events without this, and Free Roam
	     drives Music with them. Screen Recording needs no entitlement: it's a
	     privacy permission the person grants in System Settings. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
