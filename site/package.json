{
  "name": "free-roam-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/prepare-public.mjs && vite",
    "studio": "vite --mode studio --open /studio.html",
    "build": "node scripts/prepare-public.mjs && tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/check-release.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "typecheck": "tsc --noEmit",
    "library": "node scripts/export-library.mjs",
    "wallpaper": "node scripts/export-wallpaper.mjs",
    "build:release": "node scripts/release.mjs"
  },
  "dependencies": {
    "dialkit": "2.0.2",
    "motion": "13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.1",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
